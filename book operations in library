//book management
#include <iostream>
#include <string>
using namespace std;

class bookType {
    string title;
    string author[4];  
    int Numauthor;
    string publisher;
    string ISBN;
    float price;
    int copies, year;    
public:
bookType() { //constructor
    title = " ";
    Numauthor = 0;
    publisher = " ";
    ISBN = " ";
    price = 0;
    copies = 0;
    year = 0;
    for(int i=0; i<4; i++) 
    { author[i] = " "; }
    
}
void settitle(string t) { title = t; }
string getTitle() { return title; }
bool checkTitle(string t)  { 
if(title == t)
return true;
    else
    return false;
}
void setcopies(int c) { 
    if(c > 0) 
    copies = c; }
void updatecopies(int c) {   
    if(c > 0) 
    copies += c;
}
int getcopies() { return copies; }

void setAuthors(string Author[], int num) {
    if (num > 4) 
    num = 4;
    else
    Numauthor = num;
    for (int i = 0; i < num; i++) {
        author[i] = Author[i];
    }
}
void printAuthors()  {
    for (int i = 0; i < Numauthor; i++) {
        cout << author[i] << ", ";
    }
    cout<<endl; }
int getAuthorCount() { return Numauthor; }
