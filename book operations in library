    if (p>=0)
    price = p; }
float getPrice() { return price; }
void setyear(int y)
{ 
    if (y>0)
    year = y ; }
    int getyear()
    { return year;  }
void printBookDetails() {
    cout << "Title : " << title << endl;
    cout << "Authors: "; 
    printAuthors();
